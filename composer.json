{
  "name": "rinlyhour/scrap-pos",
  "description": "Single-owner Scrap Dealer POS and Inventory Management System",
  "type": "project",
  "require": {"php": "^8.2", "laravel/framework": "^12.0"},
  "require-dev": {"laravel/pint": "^1.13"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
  "scripts": {"post-autoload-dump": ["@php artisan package:discover --ansi"], "setup": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\"", "@php artisan key:generate", "@php artisan migrate --seed"]},
  "minimum-stability": "stable", "prefer-stable": true
}
